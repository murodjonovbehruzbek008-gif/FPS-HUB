# SQLite file used for local development. No cloud database required.
DATABASE_URL="file:./dev.db"

# AES-256-GCM key for sealing anonymous-report identities (64 hex chars = 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANON_SEAL_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Optional: public origin used in password-reset emails (dev writes links to dev-mailbox.json).
APP_URL="http://localhost:3000"
