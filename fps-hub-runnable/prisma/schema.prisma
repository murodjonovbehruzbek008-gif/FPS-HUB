generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ConversationKind {
  DIRECT
  CLASS
  ACTIVITY
}

enum CopyStatus {
  AVAILABLE
  RESERVED
  LOANED
  LOST
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum ReservationStatus {
  PENDING
  APPROVED
  READY
  CANCELLED
  FULFILLED
}

enum RecognitionKind {
  STUDENT_OF_MONTH
  TEACHER_OF_MONTH
  CLASS_OF_MONTH
}

enum PeriodStatus {
  OPEN
  CLOSED
  PUBLISHED
}

enum AchievementStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ModerationStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum PostCategory {
  GENERAL
  ACHIEVEMENT
  PROJECT
  EVENT
  QUESTION
  ANNOUNCEMENT
}

enum ClubRole {
  MEMBER
  MODERATOR
  LEADER
}

enum RsvpStatus {
  INTERESTED
  GOING
  NOT_GOING
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  ACHIEVEMENT
  CLUB_ACTIVITY
  EVENT_REMINDER
  ANNOUNCEMENT
  MENTION
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String        @unique @default(cuid())
  passwordHash String
  role         Role
  status       AccountStatus @default(ACTIVE)
  locale       String        @default("en")
  theme        String        @default("light")
  perms        String        @default("[]")
  displayName  String
  bio          String        @default("")
  avatarUrl    String?
  interests    String        @default("")
  grade        String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  notifyMessages      Boolean @default(true)
  notifyHomework      Boolean @default(true)
  notifyAnnouncements Boolean @default(true)
  notifyActivities    Boolean @default(true)
  notifyLibrary       Boolean @default(true)
  notifyLikes         Boolean @default(true)
  notifyComments      Boolean @default(true)
  notifyFollows       Boolean @default(true)

  sessions            Session[]
  student             StudentProfile?
  teacher             TeacherProfile?
  posts               Post[]               @relation("PostAuthor")
  comments            Comment[]
  likes               Like[]
  bookmarks           Bookmark[]
  messages            Message[]
  conversationMembers ConversationMember[]
  notifications       Notification[]
  achievements        Achievement[]        @relation("AchievementOwner")
  verifiedAchievements Achievement[]       @relation("AchievementVerifier")
  contentReports      ModerationReport[]   @relation("Reporter")
  handledReports      ModerationReport[]   @relation("Moderator")
  votes               RecognitionVote[]
  bookRatings         BookRating[]
  reservations        Reservation[]
  loans               Loan[]
  resetTokens         PasswordResetToken[]
  activityLed         Activity[]           @relation("ActivityLeader")
  activityMemberships ActivityMember[]
  activityUpdates     ActivityUpdate[]
  announcements       Announcement[]
  homeworkCreated     Homework[]
  materials           Material[]
  auditActions        AuditLog[]
  following           Follow[]             @relation("Follower")
  followers           Follow[]             @relation("Following")
  clubMemberships     ClubMember[]
  clubsLed            Club[]               @relation("ClubLeader")
  eventAttendances    EventAttendee[]

  @@index([username])
  @@index([email])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  userId      String  @id
  classId     String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class?  @relation(fields: [classId], references: [id])
  enrollments ClassEnrollment[]
  grades      Grade[]
  submissions HomeworkSubmission[]
}

model TeacherProfile {
  userId      String @id
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]
}

model Class {
  id            String              @id @default(cuid())
  name          String              @unique
  enrollments   ClassEnrollment[]
  assignments   TeacherAssignment[]
  students      StudentProfile[]
  schedule      ScheduleSlot[]
  homework      Homework[]
  announcements Announcement[]
  grades        Grade[]
  materials     Material[]
  conversations Conversation[]
}

model Subject {
  id          String              @id @default(cuid())
  name        String              @unique
  assignments TeacherAssignment[]
  grades      Grade[]
  homework    Homework[]
  schedule    ScheduleSlot[]
  materials   Material[]
}

model ClassEnrollment {
  studentId String
  classId   String
  student   StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([studentId, classId])
}

model TeacherAssignment {
  teacherId String
  classId   String
  subjectId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, classId, subjectId])
  @@index([classId, subjectId])
}

model ScheduleSlot {
  id        String  @id @default(cuid())
  classId   String
  subjectId String
  weekday   Int
  startTime String
  endTime   String
  room      String  @default("")
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([classId, weekday])
}

model Grade {
  id             String         @id @default(cuid())
  studentId      String
  subjectId      String
  classId        String
  teacherId      String
  score          Float
  assessmentType String
  note           String?
  date           DateTime
  student        StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id])
  class          Class          @relation(fields: [classId], references: [id])

  @@index([studentId, subjectId])
  @@index([classId, subjectId])
}

model Homework {
  id          String               @id @default(cuid())
  title       String
  description String
  dueAt       DateTime
  classId     String
  subjectId   String
  teacherId   String
  attachment  String?
  createdAt   DateTime             @default(now())
  class       Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject              @relation(fields: [subjectId], references: [id])
  teacher     User                 @relation(fields: [teacherId], references: [id])
  submissions HomeworkSubmission[]

  @@index([classId, dueAt])
}

model HomeworkSubmission {
  id          String         @id @default(cuid())
  homeworkId  String
  studentId   String
  status      String         @default("SUBMITTED")
  note        String         @default("")
  submittedAt DateTime       @default(now())
  homework    Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([homeworkId, studentId])
}

model Material {
  id        String   @id @default(cuid())
  title     String
  url       String
  classId   String
  subjectId String
  teacherId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacher   User     @relation(fields: [teacherId], references: [id])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  authorId    String
  classId     String?
  clubId      String?
  schoolWide  Boolean  @default(false)
  important   Boolean  @default(false)
  createdAt   DateTime @default(now())
  author      User     @relation(fields: [authorId], references: [id])
  class       Class?   @relation(fields: [classId], references: [id])
  club        Club?    @relation(fields: [clubId], references: [id])

  @@index([createdAt])
}

model Post {
  id         String       @id @default(cuid())
  authorId   String
  body       String
  category   PostCategory @default(GENERAL)
  mediaUrl   String?
  hashtags   String       @default("[]")
  clubId     String?
  eventId    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  author     User         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likes      Like[]
  bookmarks  Bookmark[]
  club       Club?        @relation(fields: [clubId], references: [id])
  event      Event?       @relation(fields: [eventId], references: [id])

  @@index([createdAt])
  @@index([authorId])
  @@index([category])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Like {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Bookmark {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId])
}

model Club {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String
  iconEmoji     String         @default("🏫")
  coverUrl      String?
  leaderId      String
  joinOpen      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  leader        User           @relation("ClubLeader", fields: [leaderId], references: [id])
  members       ClubMember[]
  posts         Post[]
  events        Event[]
  announcements Announcement[]
  achievements  Achievement[]

  @@index([slug])
}

model ClubMember {
  clubId   String
  userId   String
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
}

model Event {
  id          String          @id @default(cuid())
  title       String
  description String
  location    String          @default("")
  startsAt    DateTime
  endsAt      DateTime?
  clubId      String?
  organizer   String
  coverUrl    String?
  createdAt   DateTime        @default(now())
  club        Club?           @relation(fields: [clubId], references: [id])
  attendees   EventAttendee[]
  posts       Post[]

  @@index([startsAt])
}

model EventAttendee {
  eventId   String
  userId    String
  status    RsvpStatus @default(INTERESTED)
  createdAt DateTime   @default(now())
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model Conversation {
  id         String               @id @default(cuid())
  kind       ConversationKind     @default(DIRECT)
  title      String?
  classId    String?
  activityId String?
  createdAt  DateTime             @default(now())
  class      Class?               @relation(fields: [classId], references: [id])
  activity   Activity?            @relation(fields: [activityId], references: [id])
  members    ConversationMember[]
  messages   Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Activity {
  id            String           @id @default(cuid())
  name          String           @unique
  description   String
  schedule      String
  location      String
  leaderId      String
  joinOpen      Boolean          @default(true)
  leader        User             @relation("ActivityLeader", fields: [leaderId], references: [id])
  members       ActivityMember[]
  updates       ActivityUpdate[]
  conversations Conversation[]
}

model ActivityMember {
  activityId String
  userId     String
  status     String   @default("ACTIVE")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([activityId, userId])
}

model ActivityUpdate {
  id         String   @id @default(cuid())
  activityId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id])
}

model Achievement {
  id          String            @id @default(cuid())
  userId      String
  title       String
  description String
  category    String
  date        DateTime
  status      AchievementStatus @default(PENDING)
  attachment  String?
  verifierId  String?
  clubId      String?
  issuer      String            @default("")
  evidenceUrl String?
  user        User              @relation("AchievementOwner", fields: [userId], references: [id], onDelete: Cascade)
  verifier    User?             @relation("AchievementVerifier", fields: [verifierId], references: [id])
  club        Club?             @relation(fields: [clubId], references: [id])

  @@index([userId])
  @@index([date])
  @@index([category])
}

model Book {
  id           String        @id @default(cuid())
  title        String
  author       String
  category     String
  description  String
  coverUrl     String?
  copies       BookCopy[]
  ratings      BookRating[]
  reservations Reservation[]
  loans        Loan[]
}

model BookCopy {
  id     String     @id @default(cuid())
  bookId String
  code   String     @unique
  status CopyStatus @default(AVAILABLE)
  book   Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  loans  Loan[]
}

model Reservation {
  id        String            @id @default(cuid())
  bookId    String
  userId    String
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  book      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Loan {
  id         String     @id @default(cuid())
  bookId     String
  copyId     String
  userId     String
  borrowedAt DateTime   @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  status     LoanStatus @default(ACTIVE)
  book       Book       @relation(fields: [bookId], references: [id])
  copy       BookCopy   @relation(fields: [copyId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model BookRating {
  bookId  String
  userId  String
  stars   Int
  ratedAt DateTime @default(now())
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([bookId, userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(ANNOUNCEMENT)
  title     String
  body      String
  href      String           @default("/")
  read      Boolean          @default(false)
  actorId   String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model RecognitionPeriod {
  id            String            @id @default(cuid())
  kind          RecognitionKind
  month         Int
  year          Int
  status        PeriodStatus      @default(OPEN)
  eligibility   String            @default("TEACHERS")
  votes         RecognitionVote[]
  winnerUserId  String?
  winnerClassId String?
  publishedNote String?

  @@unique([kind, month, year])
}

model RecognitionVote {
  periodId       String
  voterId        String
  nomineeId      String?
  nomineeClassId String?
  period         RecognitionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  voter          User              @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@id([periodId, voterId])
}

model SchoolSettings {
  id                  String @id @default("school")
  name                String @default("FPS")
  classRankingWeights String @default("{\"averageGrade\":0.6,\"homeworkCompletion\":0.4}")
  teacherVoteEligible String @default("TEACHERS")
}

model ModerationReport {
  id          String           @id @default(cuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  details     String           @default("")
  status      ModerationStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?
  moderatorId String?
  reporter    User             @relation("Reporter", fields: [reporterId], references: [id])
  moderator   User?            @relation("Moderator", fields: [moderatorId], references: [id])

  @@index([status, createdAt])
}

model AnonymousReport {
  id        String             @id @default(cuid())
  category  String
  body      String
  tokenHash String             @unique
  createdAt DateTime           @default(now())
  messages  AnonymousMessage[]
  deanon    DeanonRequest[]
  identity  AnonymousIdentity?
}

model AnonymousIdentity {
  reportId     String          @id
  sealedAuthor String
  report       AnonymousReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model AnonymousMessage {
  id           String          @id @default(cuid())
  reportId     String
  fromReporter Boolean
  body         String
  createdAt    DateTime        @default(now())
  report       AnonymousReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model DeanonRequest {
  id          String          @id @default(cuid())
  reportId    String
  requesterId String
  reason      String
  approvals   String          @default("[]")
  done        Boolean         @default(false)
  report      AnonymousReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model AuditLog {
  seq      Int      @id @default(autoincrement())
  actorId  String
  action   String
  target   String
  reason   String
  outcome  String
  at       DateTime @default(now())
  prevHash String
  hash     String
  actor    User?    @relation(fields: [actorId], references: [id])
}
